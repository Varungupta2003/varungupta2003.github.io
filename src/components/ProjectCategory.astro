---
import ProjectCard from "./ProjectCard.astro";

interface ProjectData {
  title: string;
  description: string;
  tags: string[];
  githubUrl: string;
  demoUrl?: string;
  icon: "shield-alert" | "headset" | "scale" | "trending-down" | "book-open" | "code";
  accent: "blue" | "amber" | "teal" | "coral" | "violet";
}

interface Props {
  index: string;
  title: string;
  description: string;
  projects: ProjectData[];
}

const { index, title, description, projects } = Astro.props;
---

<div class="mt-16 first:mt-10">
  <div class="reveal flex items-baseline gap-3 border-b border-line pb-3">
    <span class="font-mono text-xs text-ink-dim">{index}</span>
    <h3 class="font-display text-lg font-semibold text-ink">{title}</h3>
    <span class="font-mono text-xs text-ink-dim">— {description}</span>
  </div>

  <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {
      projects.map((project) => (
        <ProjectCard
          title={project.title}
          description={project.description}
          tags={project.tags}
          githubUrl={project.githubUrl}
          demoUrl={project.demoUrl}
          icon={project.icon}
          accent={project.accent}
        />
      ))
    }
  </div>
</div>
