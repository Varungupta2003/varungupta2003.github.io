---
import Icon from "./Icon.astro";
import { getRepoMeta, relativeTime, repoPathFromUrl } from "../lib/github";

interface Props {
  title: string;
  description: string;
  tags: string[];
  githubUrl: string;
  demoUrl?: string;
  icon: "shield-alert" | "headset" | "scale" | "trending-down" | "book-open" | "code";
  accent?: "blue" | "amber" | "teal" | "coral" | "violet";
}

const {
  title,
  description,
  tags,
  githubUrl,
  demoUrl,
  icon,
  accent = "blue",
} = Astro.props;

const accentClasses: Record<
  string,
  { text: string; bg: string; glow: string; hoverText: string }
> = {
  blue: {
    text: "text-blue",
    bg: "bg-blue-soft",
    glow: "group-hover:shadow-[0_0_40px_-12px_var(--color-blue)]",
    hoverText: "hover:text-blue",
  },
  amber: {
    text: "text-amber",
    bg: "bg-amber-soft",
    glow: "group-hover:shadow-[0_0_40px_-12px_var(--color-amber)]",
    hoverText: "hover:text-amber",
  },
  teal: {
    text: "text-teal",
    bg: "bg-teal-soft",
    glow: "group-hover:shadow-[0_0_40px_-12px_var(--color-teal)]",
    hoverText: "hover:text-teal",
  },
  coral: {
    text: "text-coral",
    bg: "bg-coral-soft",
    glow: "group-hover:shadow-[0_0_40px_-12px_var(--color-coral)]",
    hoverText: "hover:text-coral",
  },
  violet: {
    text: "text-violet",
    bg: "bg-violet-soft",
    glow: "group-hover:shadow-[0_0_40px_-12px_var(--color-violet)]",
    hoverText: "hover:text-violet",
  },
};
const a = accentClasses[accent];
const repoMeta = await getRepoMeta(repoPathFromUrl(githubUrl));
---

<article
  class={`card-3d group reveal flex h-full flex-col overflow-hidden rounded-2xl border border-line bg-surface transition-shadow duration-300 ${a.glow}`}
>
  <div class={`flex h-28 items-center justify-center ${a.bg}`}>
    <Icon name={icon} class={`h-9 w-9 ${a.text}`} />
  </div>

  <div class="flex flex-1 flex-col p-6">
    <h3 class="font-display text-lg font-semibold text-ink">{title}</h3>
    <p class="mt-2 flex-1 text-sm leading-relaxed text-ink-muted">
      {description}
    </p>

    <ul class="mt-4 flex flex-wrap gap-1.5" aria-label="Tech stack">
      {
        tags.map((tag) => (
          <li class="rounded-full border border-line bg-surface-raised px-2.5 py-1 font-mono text-[11px] text-ink-muted">
            {tag}
          </li>
        ))
      }
    </ul>

    <div class="mt-5 flex items-center gap-4 border-t border-line pt-4">
      <a
        href={githubUrl}
        target="_blank"
        rel="noopener noreferrer"
        class={`inline-flex items-center gap-1.5 text-sm font-medium text-ink-muted transition-colors ${a.hoverText}`}
      >
        <Icon name="github" class="h-4 w-4" />
        Code
      </a>
      {
        demoUrl && (
          <a
            href={demoUrl}
            target="_blank"
            rel="noopener noreferrer"
            class={`inline-flex items-center gap-1.5 text-sm font-medium text-ink-muted transition-colors ${a.hoverText}`}
          >
            <Icon name="external-link" class="h-4 w-4" />
            Live demo
          </a>
        )
      }
    </div>

    {
      repoMeta && (
        <div class="mt-3 flex items-center gap-1.5 font-mono text-[10px] text-ink-dim">
          <span class="relative flex h-1.5 w-1.5">
            <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-teal opacity-75" />
            <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-teal" />
          </span>
          Synced from GitHub · pushed {relativeTime(repoMeta.updatedAt)}
          {repoMeta.language && ` · ${repoMeta.language}`}
        </div>
      )
    }
  </div>
</article>
