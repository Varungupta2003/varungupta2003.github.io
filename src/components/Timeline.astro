---
const experience = [
  {
    role: "President, Enigma IT Club",
    org: "JIMS Vasant Kunj",
    period: "Feb – Jun 2024",
    detail: "Led a 25+ member technical org, secured sponsorships, cut operational costs 40%+",
  },
  {
    role: "RPA Intern",
    org: "IBOTIX LLP",
    period: "Aug – Sep 2023",
    detail: "Built 3+ UiPath automation bots, improved process efficiency 50%",
  },
  {
    role: "Video Editor",
    org: "MARKHEADS",
    period: "Sep – Nov 2023",
    detail: "",
  },
];

const education = [
  {
    role: "MSc Artificial Intelligence",
    org: "University of East London",
    period: "May 2025 – May 2026",
    detail: "",
  },
  {
    role: "BCA, Computer Science",
    org: "Jagannath International Management School, Vasant Kunj",
    period: "Dec 2021 – Jul 2024",
    detail: "",
  },
];
---

<section id="experience" class="border-b border-line bg-surface/40">
  <div class="mx-auto max-w-5xl px-6 py-24">
    <h2 class="reveal font-mono text-xs font-semibold uppercase tracking-[0.25em] text-blue">
      // Experience &amp; Education
    </h2>

    <div class="mt-10 grid gap-10 md:grid-cols-2">
      <div class="reveal">
        <h3 class="font-mono text-xs font-semibold uppercase tracking-wide text-ink-dim">
          Experience log
        </h3>
        <ol class="mt-4 space-y-6 border-l border-line pl-5">
          {
            experience.map((item) => (
              <li class="relative">
                <span class="absolute -left-[23px] top-1.5 h-2 w-2 rounded-full bg-blue" />
                <p class="font-mono text-xs text-ink-dim">{item.period}</p>
                <p class="mt-0.5 font-display text-sm font-semibold text-ink">
                  {item.role}
                </p>
                <p class="font-mono text-sm text-blue">{item.org}</p>
                {item.detail && (
                  <p class="mt-1 text-sm text-ink-muted">{item.detail}</p>
                )}
              </li>
            ))
          }
        </ol>
      </div>

      <div class="reveal" data-delay="0.1">
        <h3 class="font-mono text-xs font-semibold uppercase tracking-wide text-ink-dim">
          Education
        </h3>
        <ol class="mt-4 space-y-6 border-l border-line pl-5">
          {
            education.map((item) => (
              <li class="relative">
                <span class="absolute -left-[23px] top-1.5 h-2 w-2 rounded-full bg-amber" />
                <p class="font-mono text-xs text-ink-dim">{item.period}</p>
                <p class="mt-0.5 font-display text-sm font-semibold text-ink">
                  {item.role}
                </p>
                <p class="font-mono text-sm text-amber">{item.org}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </div>
</section>
